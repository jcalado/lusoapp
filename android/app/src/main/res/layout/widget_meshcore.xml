<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="16dp">

    <!-- Header: radio name + status dot/label, GPS pin -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_radio_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:fontFamily="monospace"
            android:text="—"
            android:textColor="@color/widget_on_surface"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/widget_gps_badge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_widget_location"
            android:tint="@color/widget_on_surface_variant"
            android:contentDescription="GPS"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_status_dot_offline" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OFFLINE"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

    </LinearLayout>

    <!-- Metric strip: battery / contacts / channels, last-updated on right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/widget_battery_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_widget_battery_alert"
            android:tint="@color/widget_on_surface_variant"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/widget_on_surface_outline"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_widget_people"
            android:tint="@color/widget_on_surface_variant"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_contacts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:textColor="@color/widget_on_surface_outline"
            android:textSize="13sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="4dp"
            android:src="@drawable/ic_widget_tag"
            android:tint="@color/widget_on_surface_variant"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_channels"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0"
            android:textColor="@color/widget_on_surface"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="--:--"
            android:textColor="@color/widget_on_surface_outline"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Spacer pushes the action row to the bottom on tall widgets -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <!-- Action row: circular filled-tonal icon buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:weightSum="5">

        <!-- SOS — tonal error container, label visible -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/widget_btn_sos"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_action_btn_sos_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_warning"
                    android:tint="@color/widget_on_error"
                    android:contentDescription="SOS" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SOS"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

        <!-- Advert -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/widget_btn_advert"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_action_btn_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_broadcast"
                    android:tint="@color/widget_on_surface"
                    android:contentDescription="Anúncio" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="14dp" />
        </LinearLayout>

        <!-- Chats -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/widget_btn_chats"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_action_btn_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_chat"
                    android:tint="@color/widget_on_surface"
                    android:contentDescription="Chats" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="14dp" />
        </LinearLayout>

        <!-- Map -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/widget_btn_map"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_action_btn_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_map"
                    android:tint="@color/widget_on_surface"
                    android:contentDescription="Mapa" />
            </FrameLayout>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="14dp" />
        </LinearLayout>

        <!-- Connect — colour swaps via provider; label below shows state -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <FrameLayout
                android:id="@+id/widget_btn_connect"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/widget_action_btn_bg">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:id="@+id/widget_btn_connect_icon"
                    android:src="@drawable/ic_widget_power"
                    android:tint="@color/widget_on_surface"
                    android:contentDescription="Conectar" />
            </FrameLayout>
            <TextView
                android:id="@+id/widget_btn_connect_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="LIGAR"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
